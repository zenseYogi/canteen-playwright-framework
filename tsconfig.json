{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@config/*": ["config/*"],
      "@fixtures/*": ["fixtures/*"],
      "@screens/*": ["screens/*"]
    }
  },
  "include": ["config/**/*", "fixtures/**/*", "screens/**/*", "tests/**/*", "playwright.config.ts"],
  "exclude": ["node_modules", "reports"]
}
